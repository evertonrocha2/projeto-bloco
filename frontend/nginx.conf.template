server {
    listen 8080;
    root /usr/share/nginx/html;

    # Upload de avatar/capa: o gateway aceita ate 6 MB (spring.servlet.multipart).
    client_max_body_size 6m;

    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Liveness/readiness do container.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Assets com hash no nome: cache longo e seguro.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: /games/7 nao e arquivo, e rota do React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
