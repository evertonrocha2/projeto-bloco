<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM pai (agregador) do Projeto de Bloco.
         Ate o TP2 existia um projeto Maven so (o monolito). No TP3 o
         sistema passou a ter cinco aplicacoes Spring Boot, entao a gente promoveu
         a raiz a projeto multi-modulo. Ganhos concretos:
           - "mvn test" na raiz roda os testes de TODOS os servicos de uma vez;
           - a versao do Spring Boot e do trem do Spring Cloud fica declarada em
             UM lugar so, entao nao existe risco de dois servicos usarem versoes
             diferentes e quebrarem na comunicacao. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.gamelog</groupId>
    <artifactId>projeto-bloco</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- packaging "pom": este projeto nao gera jar, ele so agrega os modulos. -->
    <packaging>pom</packaging>
    <name>projeto-bloco</name>
    <description>GameLog - monolito modular + microsservico de recomendacoes</description>

    <properties>
        <java.version>21</java.version>
        <!-- Trem de release do Spring Cloud. A escolha NAO e livre: cada trem
             suporta uma faixa de versoes do Spring Boot. O 2023.0.x e a linha
             compativel com Boot 3.3.x (que e a nossa). Subir pra 2024.0.x
             exigiria subir o Boot pra 3.4.x tambem. -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <!-- TP4: os testes de integracao sobem um RabbitMQ de verdade num container.
             O Boot 3.3.5 traria o Testcontainers 1.20.x, que fala com o Docker numa
             versao de API que o Docker Engine 29 recusa ("client version too old").
             A 1.21.4 negocia a versao da API e funciona nos dois lados: na maquina
             de desenvolvimento e no runner do GitHub Actions. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- TP5: appender que empurra os logs pro Loki. A linha 1.5 e a ultima com
             a sintaxe de configuracao usada em logback-spring.xml. -->
        <loki-logback-appender.version>1.5.2</loki-logback-appender.version>
    </properties>

    <!-- A estrutura de pastas separa APLICACOES de INFRAESTRUTURA.
         services/ guarda o que tem regra de negocio; platform/ guarda o
         encanamento que faz esses servicos se acharem e conversarem.

         O monolito mora em services/gamelog junto com o microsservico, e nao
         numa pasta "backend" a parte, porque ele TAMBEM e um servico: registra-se
         no Eureka, busca configuracao no Config Server e e alcancado por
         lb://gamelog igual ao outro. Uma pasta chamada "backend" ao lado de
         "services" sugeriria que ele e outra categoria de coisa, o que nao e
         verdade desde o TP3. -->
    <modules>
        <!-- Aplicacoes de negocio -->
        <module>services/gamelog</module>
        <module>services/recommendation-service</module>
        <!-- TP4: segundo assinante dos eventos do monolito -->
        <module>services/notification-service</module>

        <!-- Infraestrutura Spring Cloud -->
        <module>platform/config-server</module>
        <module>platform/discovery-server</module>
        <module>platform/api-gateway</module>
        <!-- TP5: biblioteca comum de observabilidade (nao e aplicacao) -->
        <module>platform/observability</module>
    </modules>

    <!-- TP5: base de observabilidade comum a TODOS os servicos.

         Declarada no pai, e nao em cada modulo, pelo mesmo motivo das versoes: um
         servico sem metrica ou sem trace e um buraco no painel justamente na hora
         em que se precisa dele. Servico novo herda tudo sem lembrar de nada.

           actuator ................ health (probes do Kubernetes), info, metricas
           prometheus .............. /actuator/prometheus, raspado pelo Prometheus
           tracing (brave) ......... traceId/spanId em cada requisicao e mensagem,
                                     propagados em header HTTP e AMQP
           zipkin reporter ......... envia os spans pro Zipkin
           loki appender ........... envia os logs pro Loki (perfil "loki") -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>${loki-logback-appender.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Nos testes nao ha Zipkin nem Loki: sem isto cada teste tentaria
                 exportar spans pra localhost:9411 e encheria o log de conexao
                 recusada. O comportamento de tracing que importa (propagacao pelo
                 outbox) e testado com o Tracer em memoria. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <management.tracing.enabled>false</management.tracing.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Importa o BOM do Spring Cloud. A partir daqui os modulos declaram
                 as dependencias de Spring Cloud SEM versao, e o BOM resolve. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
