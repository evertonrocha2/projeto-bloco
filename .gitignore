# Java / Maven
# Vale pra qualquer modulo: os servicos em services/ e a infra em platform/.
target/
*.class

# Bancos H2 em arquivo (dados locais, nao vao pro repositorio).
# Sao DOIS bancos separados - um por servico - e essa separacao e o ponto:
# o microsservico nao compartilha tabela com o monolito.
services/gamelog/data/
services/recommendation-service/data/

# Imagens enviadas pelos usuarios. Sao dado de execucao, nao codigo - e o
# repositorio nao e lugar de guardar arquivo que qualquer pessoa logada pode
# subir. Fica fora de data/ de proposito, pra sobreviver quando o banco e apagado
# por mudanca de esquema.
services/gamelog/uploads/

# PDFs (entregas e documentos nao vao pro repositorio)
*.pdf
*.PDF

# Node / Vite
frontend/node_modules/
frontend/dist/

# Logs e variaveis de ambiente
*.log
logs/
.env
.env.local

# IDE
.idea/
.vscode/
*.iml

# Imagem de referencia de design (nao faz parte do app)
frontend/src/original-*.webp
