<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Antes este modulo herdava direto do spring-boot-starter-parent. No TP3 ele
         passou a herdar do POM pai do projeto, que por sua vez herda do
         starter-parent. O motivo: com cinco aplicacoes Spring Boot no
         repositorio, a versao do Boot e do Spring Cloud precisa estar declarada
         num lugar unico - servicos que conversam entre si com versoes diferentes
         de biblioteca e um problema chato de achar. -->
    <parent>
        <groupId>com.gamelog</groupId>
        <artifactId>projeto-bloco</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>gamelog</artifactId>
    <name>gamelog</name>
    <description>GameLog - um Letterboxd de jogos (monolito modular)</description>

    <dependencies>
        <!-- Web: controllers REST, Tomcat embutido, Jackson pra JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA + Hibernate pra falar com o banco usando objetos Java -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Hibernate Envers: guarda o historico de mudancas das entidades
             marcadas com @Audited em tabelas *_aud. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-envers</artifactId>
        </dependency>

        <!-- Integracao do Spring Data com o Envers: e o que nos da o
             RevisionRepository (findRevisions etc.) nos repositorios. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-envers</artifactId>
        </dependency>

        <!-- Seguranca: filtros, contexto de autenticacao, BCrypt -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation (@NotBlank, @Min, etc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Banco H2 em memoria. Some quando a aplicacao para. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Biblioteca pra gerar e validar os tokens JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- === Spring Cloud (TP3) ===
             O monolito nao virou microsservico, mas passou a fazer PARTE de um
             sistema distribuido: ele se registra no Eureka (pra que o
             recommendation-service o encontre pelo nome, sem endereco fixo) e
             busca configuracao no Config Server. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- Expoe /actuator/health, usado pelo Eureka e pelo gateway pra saber se
             o servico esta saudavel. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin que empacota tudo num jar executavel e roda o spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Os testes desligam Config Server e Eureka.
                 Um teste tem que dar o mesmo resultado com ou sem a
                 infraestrutura no ar - se "mvn test" passasse so em quem tem os
                 cinco servicos rodando, o build deixaria de ser confiavel. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.cloud.config.enabled>false</spring.cloud.config.enabled>
                        <eureka.client.enabled>false</eureka.client.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
